{
	order mercure after encode
	skip_install_trust
	# REQ-RUNTIME-001: cap how long a request waits for a free PHP thread (504 instead of an endless queue).
	frankenphp {
		max_wait_time 30s
	}
}

:80 {
	root * /app/public
	encode zstd br gzip
	mercure {
		anonymous
	}

	php_server {
		hot_reload
		worker {
			file /app/public/index.php
			watch
		}
	}
}
