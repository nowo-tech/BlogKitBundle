{% extends 'base.html.twig' %}

{% block title %}Blog Kit Demo{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-body">
                <h1 class="h3 mb-3">Blog kit</h1>
                <p class="text-muted">
                    Artículos, tags, comentarios y ajustes del
                    <strong>BlogKitBundle</strong>.
                </p>
                <p class="small text-muted">Página generada a las {{ generatedAt }}.</p>
                <div class="d-flex flex-wrap gap-2">
                    <a class="btn btn-primary" href="{{ path('blog_index') }}">Blog público</a>
                    <a class="btn btn-success" href="{{ path('admin_blog_index') }}">Admin (HTTP Basic: admin / admin)</a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
