{% extends 'base.html.twig' %}

{% block title %}Nowo · Blog kit{% endblock %}

{% block nowo_ui_page_header %}
    <div class="nowo-ui-page-header">
        <h1 class="nowo-ui-page-header__title" data-testid="demo-home-title">Blog kit</h1>
        <p class="nowo-ui-muted">Artículos, tags, comentarios y ajustes del <strong>BlogKitBundle</strong>.</p>
    </div>
{% endblock %}

{% block body %}
<section class="nowo-ui-card" data-testid="demo-hero">
    <div class="nowo-ui-card__body">
        <div class="nowo-ui-row-actions">
            <a class="nowo-ui-btn nowo-ui-btn--primary" href="{{ path('blog_index') }}">Leer el blog</a>
            <a class="nowo-ui-btn nowo-ui-btn--outline" href="{{ path('admin_blog_index') }}">Admin</a>
        </div>
    </div>
</section>
{% endblock %}
