{% extends 'base.html.twig' %}

{% block title %}Nowo · Blog kit{% endblock %}

{% block nowo_ui_page_header %}
    {% set _toolbar %}
        <a class="nowo-ui-btn nowo-ui-btn--outline" href="{{ path('admin_blog_index') }}">Admin</a>
        <a class="nowo-ui-btn nowo-ui-btn--primary" href="{{ path('blog_index') }}">Leer el blog</a>
    {% endset %}
    {{ include(nowo_ui_partial('page_header'), {
        title: 'Blog kit',
        intro: 'Artículos, tags, comentarios y ajustes del BlogKitBundle.',
        toolbar: _toolbar,
    }) }}
{% endblock %}

{% block body %}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Qué puedes probar', kind: 'list', testid: 'demo-hero'} %}
        {% block section_body %}
            <div class="nowo-ui-stack">
                <p class="nowo-ui-muted">Listado de artículos, buscador y detalle con comentarios.</p>
                <div class="nowo-ui-page-actions"><a class="nowo-ui-btn nowo-ui-btn--outline" href="{{ path('blog_index') }}">Blog público</a></div>
                <p class="nowo-ui-muted">Artículos, tags, comentarios y ajustes (HTTP Basic, admin / admin).</p>
                <div class="nowo-ui-page-actions"><a class="nowo-ui-btn nowo-ui-btn--outline" href="{{ path('admin_blog_index') }}">Administración</a></div>
            </div>
        {% endblock %}
    {% endembed %}
{% endblock %}
