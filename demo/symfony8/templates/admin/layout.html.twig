{% extends 'base.html.twig' %}
{% trans_default_domain 'NowoBlogKitBundle' %}
{% import '@NowoUiKitBundle/macros/ui.html.twig' as ui %}
{% set _css_fw = nowo_blog_kit_css_framework|default('bootstrap5') %}

{#
  Host chrome for BlogKit admin (REQ-UI-001).
  Pages extend @NowoBlogKitBundle/admin/base.html.twig → this layout.
  Keep stylesheets / javascripts so parent() stacks nowo-ui.css + blog.css.
#}

{% block body_class %} demo-shell--admin{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
{% endblock %}

{% block demo_nav %}
    <a href="{{ path('blog_index') }}">Blog</a>
    <a href="{{ path('admin_blog_index') }}" aria-current="page">Admin</a>
{% endblock %}

{% block body %}
<div class="demo-admin">
    {% block nowo_ui_flashes %}
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="{{ ui.flash(label == 'error' ? 'error' : label, _css_fw) }}" role="alert">{{ message|trans }}</div>
            {% endfor %}
        {% endfor %}
    {% endblock %}
    {% block admin %}{% endblock %}
    {% block nowo_ui_content %}{% endblock %}
</div>
{% block nowo_ui_modals %}{% endblock %}
{% endblock %}
