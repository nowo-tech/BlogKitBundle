{#
  Demo host guest layout (REQ-UI-003, nowo_ui_kit.layouts.guest): the demo shell with the UiKit canonical blocks,
  without admin chrome. The public blog pages (index, article) render here.
#}
{% extends 'base.html.twig' %}
{% use '@NowoUiKit/layout/_bridge.html.twig' %}
{% set nowo_ui_document_title_suffix = 'Nowo · Blog kit' %}

{% block title %}{{ block('nowo_ui_bridge_title') }}{% endblock %}

{% block stylesheets %}
    {{ include('layouts/_ui_assets.html.twig') }}
    {{ block('nowo_ui_bridge_assets') }}
{% endblock %}

{% block body %}
    <div class="demo-public">{{ block('nowo_ui_bridge_body') }}</div>
{% endblock %}

{% block javascripts %}
    {{ include(nowo_ui_partial('scripts', nowo_ui_bundle|default(null))) }}
    {{ block('nowo_ui_bridge_end') }}
{% endblock %}
