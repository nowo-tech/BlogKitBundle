<!DOCTYPE html>
<html lang="{{ app.request.locale|default('es') }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Nowo · Blog kit{% endblock %}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,650&family=Outfit:wght@400;500;600&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="{{ asset('css/demo-blog.css') }}" rel="stylesheet">
    {% block stylesheets %}{% endblock %}
</head>
<body class="demo-shell{% block body_class %}{% endblock %}">
<header class="demo-masthead">
    <div class="demo-masthead__inner">
        {% block masthead_brand %}
            <a class="demo-wordmark" href="{{ path('demo_home') }}">Nowo</a>
        {% endblock %}
        <nav class="demo-nav" aria-label="Demo">
            {% block demo_nav %}
                <a href="{{ path('blog_index') }}">Blog</a>
                <a href="{{ path('admin_blog_index') }}">Admin</a>
            {% endblock %}
        </nav>
    </div>
</header>
<main>
    {% block body %}{% endblock %}
</main>
{% block footer %}
<footer class="demo-colophon">
    <p>Demo de <strong>BlogKitBundle</strong> · Symfony 8</p>
</footer>
{% endblock %}
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" defer></script>
{% block javascripts %}{% endblock %}
</body>
</html>
