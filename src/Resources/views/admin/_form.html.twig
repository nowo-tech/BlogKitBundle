{% trans_default_domain 'NowoBlogKitBundle' %}
{% import '@NowoUiKitBundle/macros/ui.html.twig' as ui %}
{% set _css_fw = nowo_blog_kit_css_framework|default('tailwind') %}

{{ form_start(form, {attr: {class: 'nowo-ui-form'}}) }}
  {% if form.translations is defined %}
    {{ include('@NowoBlogKitBundle/admin/_locale_tabs.html.twig', {
      translations: form.translations,
      active_locale: active_locale|default(null),
    }) }}
  {% endif %}
  {% for child in form %}
    {% if not child.rendered %}
      {{ form_row(child) }}
    {% endif %}
  {% endfor %}
  <div class="nowo-ui-form-actions">
    <button type="submit" class="{{ ui.btn('primary', null, _css_fw) }}">{{ 'admin.action.save'|trans }}</button>
    <a href="{{ cancel_path|default(path('admin_blog_index')) }}" class="{{ ui.btn('secondary', null, _css_fw) }}">{{ 'admin.action.cancel'|trans }}</a>
  </div>
{{ form_end(form) }}
