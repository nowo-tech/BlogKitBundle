{#
  Inline CMS editor fragment (GET /admin/blog/{id}/edit-modal, posts to /admin/blog/{id}/inline): the UiKit `dialog`
  partial (native <dialog>, opened) around the BlogInlineModalType form. Not a page: the host inserts it into its own
  page. Variables: form (FormView), locale (the tab opened first).
#}
{% trans_default_domain 'NowoBlogKitBundle' %}
{% set _b = 'NowoBlogKitBundle' %}
{% set _form_id = 'cms-modal-active-form' %}
{% set _footer %}
    <button type="submit" form="{{ _form_id }}" class="{{ nowo_ui_class('btn_primary', _b) }}">{{ 'admin.action.save'|trans }}</button>
    <button type="button" class="{{ nowo_ui_class('btn_secondary', _b) }}" data-nowo-ui-dialog-close>{{ 'admin.action.cancel'|trans }}</button>
{% endset %}
{% embed nowo_ui_partial('dialog', _b) with {
    id: 'blog-kit-cms-modal',
    title: 'admin.articles.edit'|trans,
    size: 'lg',
    bundle: _b,
    attr: {open: true, 'data-blog-kit-cms-modal': true},
    footer: _footer,
    form: form,
    form_id: _form_id,
    active_locale: locale|default(active_locale|default(null)),
} only %}
    {% block nowo_ui_dialog_body %}
        {{ form_start(form, {attr: {class: nowo_ui_class('form', bundle) ~ ' cms-modal-form', id: form_id}}) }}
            {{ include('@NowoBlogKitBundle/admin/_form_body.html.twig', {form: form, tabs_id: 'cms-locale', active_locale: active_locale, testid: 'blog-kit-cms-locale-tabs'}) }}
        {{ form_end(form) }}
    {% endblock %}
{% endembed %}
