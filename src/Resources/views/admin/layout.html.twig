{% trans_default_domain 'NowoBlogKitBundle' %}
{% import '@NowoUiKitBundle/macros/ui.html.twig' as ui %}
{% set _css_fw = nowo_blog_kit_css_framework|default('tailwind') %}
<!DOCTYPE html>
<html lang="{{ app.request.locale|default('en') }}" class="nowo-ui-html nowo-ui--{{ _css_fw }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}{{ 'admin.title'|trans }}{% endblock %}</title>
    {% block stylesheets %}{% endblock %}
</head>
<body class="nowo-ui-body">
    <div class="nowo-ui-container container py-4">
        <header class="nowo-ui-header mb-4">
            <h1 class="nowo-ui-title">{% block page_heading %}{{ 'admin.title'|trans }}{% endblock %}</h1>
        </header>
        <main class="nowo-ui-main">
            {% block nowo_ui_flashes %}
                {% for label, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="{{ ui.flash(label == 'error' ? 'error' : label, _css_fw) }}" role="alert">{{ message|trans }}</div>
                    {% endfor %}
                {% endfor %}
            {% endblock %}
            {% block admin %}{% endblock %}
            {% block nowo_ui_content %}{% endblock %}
        </main>
    </div>
    {% block javascripts %}{% endblock %}
</body>
</html>
