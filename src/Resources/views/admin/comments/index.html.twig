{#
  Comment moderation (REQ-UI-003): UiKit list scaffold. Variables: page (View\ListPage from
  BlogCommentController::index(): header admin.comments.title, intro = pending count, status filter actions (pending,
  approved, rejected, all; the current one primary) and the blog area nav as tabs; columns date, article, author,
  comment, status, reply; rows = list<BlogComment>; row actions Approve / Reject (pending only, POST + CSRF FormView)
  and Delete (POST + CSRF FormView behind a Confirm); filters = BlogCommentFilterType; EmptyState
  admin.comments.empty), reply_forms (comment id => StaffBlogCommentReplyType FormView), and the 1.x variables
  page_title, items, filters, filter, filter_form, pending_count, action_forms.
  Data block filled: nowo_ui_list_row (cells; the reply cell holds the staff reply form).
#}
{% extends '@NowoUiKit/page/list.html.twig' %}
{% trans_default_domain 'NowoBlogKitBundle' %}

{% block nowo_ui_styles %}
    {{ parent() }}
    {{ include('@NowoBlogKitBundle/_stylesheets.html.twig') }}
{% endblock %}

{% block nowo_ui_list_row %}
    {% set _b = page.bundle %}
    {% set _cell = nowo_ui_class('table_cell', _b) %}
    {% set _tones = {pending: 'badge_warning', approved: 'badge_success', rejected: 'badge_neutral'} %}
    <td class="{{ _cell }}" data-label="{{ 'admin.column.date'|trans }}"><time datetime="{{ row.createdAt|date('c') }}">{{ row.createdAt|date('Y-m-d H:i') }}</time></td>
    <td class="{{ _cell }}" data-label="{{ 'admin.column.article'|trans }}" data-nowo-ui-priority="2">
        {% if row.article %}
            <a href="{{ path('blog_show', {slug: row.article.slug}) }}" target="_blank" rel="noopener">{{ row.article.slug }}</a>
        {% endif %}
    </td>
    <td class="{{ _cell }}" data-label="{{ 'admin.column.author'|trans }}">{{ row.displayAuthorName }}</td>
    <td class="{{ _cell }}" data-label="{{ 'admin.column.comment'|trans }}" data-required="1">{{ row.body|u.truncate(180) }}</td>
    <td class="{{ _cell }}" data-label="{{ 'admin.column.status'|trans }}"><span class="{{ nowo_ui_class(_tones[row.status.value] ?? 'badge_neutral', _b) }}">{{ ('admin.status.' ~ row.status.value)|trans }}</span></td>
    <td class="{{ _cell }}" data-label="{{ 'admin.column.reply'|trans }}" data-nowo-ui-priority="3">
        {% if reply_forms[row.id] is defined %}
            {% set _reply = reply_forms[row.id] %}
            {{ form_start(_reply, {attr: {class: nowo_ui_class('form', _b) ~ ' blog-comment-reply-form'}}) }}
                {% for child in _reply %}
                    {% if not child.rendered %}
                        {{ form_row(child) }}
                    {% endif %}
                {% endfor %}
                <button type="submit" class="{{ nowo_ui_class('btn_secondary', _b) }} {{ nowo_ui_class('btn_sm', _b) }}">{{ 'blog.comments.reply_submit'|trans }}</button>
            {{ form_end(_reply) }}
        {% endif %}
    </td>
{% endblock %}
