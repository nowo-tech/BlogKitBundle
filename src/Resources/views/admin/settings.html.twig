{#
  Blog settings (REQ-UI-003): UiKit settings scaffold. Variables: page (View\SettingsPage from BlogSettingsController:
  header admin.settings.title / admin.settings.lead with the blog area nav as tabs; one SettingsSection per settings
  section — listing, cards, index-aside, article, comments — with its href (section tabs), current = this section,
  which carries the BlogSettingsType form of that section, its lead as intro and the submit admin.action.save), and the
  1.x variables page_title, form, edit_section.
  Data block filled: nowo_ui_settings_section (the article section groups its fields under two sub-headings, then the
  REQ-TWIG-003 child loop and the submit row through the UiKit `section_form` contract).
#}
{% extends '@NowoUiKit/page/settings.html.twig' %}
{% trans_default_domain 'NowoBlogKitBundle' %}

{% block nowo_ui_styles %}
    {{ parent() }}
    {{ include('@NowoBlogKitBundle/_stylesheets.html.twig') }}
{% endblock %}

{% block nowo_ui_settings_section %}
    {% set _b = page.bundle %}
    {% set _form = section.form %}
    {% if _form %}
        <div class="blog-settings-section" data-testid="blog-kit-settings-{{ section.id }}">
            {{ form_start(_form, {attr: {class: nowo_ui_class('form', _b), 'data-nowo-ui-region': 'form'}}) }}
                {% if section.id == 'article' %}
                    <h3 class="{{ nowo_ui_class('card_title', _b) }} blog-settings-section__group">{{ 'admin.settings.sections.article_aside'|trans }}</h3>
                {% endif %}
                {% for child in _form %}
                    {% if not child.rendered %}
                        {% if section.id == 'article' and child.vars.name == 'showShare' %}
                            <h3 class="{{ nowo_ui_class('card_title', _b) }} blog-settings-section__group">{{ 'admin.settings.sections.article_display'|trans }}</h3>
                        {% endif %}
                        {{ form_row(child) }}
                    {% endif %}
                {% endfor %}
                <div class="{{ nowo_ui_class('form_actions', _b) }}"{{ nowo_ui_attrs('form_actions', _b) }}>
                    <button type="submit" class="{{ nowo_ui_class('btn_primary', _b) }}">{{ section.submitLabel|nowo_ui_trans }}</button>
                </div>
            {{ form_end(_form) }}
        </div>
    {% endif %}
{% endblock %}
