{% block _blog_article_resources_widget %}
  {% trans_default_domain 'NowoBlogKitBundle' %}
  {% set _b = 'NowoBlogKitBundle' %}
  {% set _btn = nowo_ui_class('btn_secondary', _b) ~ ' ' ~ nowo_ui_class('btn_sm', _b) %}
  {% set prototype_html %}
    <div class="admin-collection__item" data-form-collection-target="entry">
      <div class="admin-collection__fields">
        {% for child in form.vars.prototype %}
          {% if not child.rendered %}
            {{ form_row(child) }}
          {% endif %}
        {% endfor %}
      </div>
      <button
        type="button"
        class="{{ _btn }} admin-collection__remove"
        data-action="form-collection#remove"
      >
        {{ 'admin.collection.remove'|trans }}
      </button>
    </div>
  {% endset %}

  <div
    class="admin-collection"
    data-controller="form-collection"
    data-prototype="{{ prototype_html|e('html_attr') }}"
    data-form-collection-prototype-name-value="__name__"
    data-form-collection-index-value="{{ form|length }}"
  >
    <div class="admin-collection__list" data-form-collection-target="list">
      {% for resourceForm in form %}
        <div class="admin-collection__item" data-form-collection-target="entry">
          <div class="admin-collection__fields">
            {% for child in resourceForm %}
              {% if not child.rendered %}
                {{ form_row(child) }}
              {% endif %}
            {% endfor %}
          </div>
          <button
            type="button"
            class="{{ _btn }} admin-collection__remove"
            data-action="form-collection#remove"
          >
            {{ 'admin.collection.remove'|trans }}
          </button>
        </div>
      {% else %}
        <p class="admin-collection__empty {{ nowo_ui_class('muted', _b) }}" data-form-collection-target="empty">{{ 'admin.collection.empty_resources'|trans }}</p>
      {% endfor %}
    </div>
    <button type="button" class="{{ _btn }}" data-action="form-collection#add">
      {{ 'admin.collection.add_resource'|trans }}
    </button>
  </div>
{% endblock %}
