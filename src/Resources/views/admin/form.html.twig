{#
  Article create / edit (REQ-UI-003): UiKit form scaffold. Variables: page (View\FormPage from
  BlogArticleController: header admin.articles.new / admin.articles.edit with a back link to the articles; form =
  BlogArticleType; submit admin.action.save; cancel = articles list), and the 1.x variables page_title, form, article
  (edit).
  Data block filled: nowo_ui_form_body (locale tabs of the translations, then the REQ-TWIG-003 child loop).
#}
{% extends '@NowoUiKit/page/form.html.twig' %}
{% trans_default_domain 'NowoBlogKitBundle' %}

{% block nowo_ui_styles %}
    {{ parent() }}
    {{ include('@NowoBlogKitBundle/_stylesheets.html.twig') }}
{% endblock %}

{% block nowo_ui_form_body %}
    {{ include('@NowoBlogKitBundle/admin/_form_body.html.twig', {form: page.form}) }}
{% endblock %}

{% block nowo_ui_scripts %}
    {{ parent() }}
    {{ include('@NowoBlogKitBundle/_scripts.html.twig') }}
{% endblock %}
