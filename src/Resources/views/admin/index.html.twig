{#
  Articles (REQ-UI-003): UiKit list scaffold. Variables: page (View\ListPage from BlogArticleController::index():
  header admin.articles.title with the action New article and the blog area nav as tabs; columns position, slug,
  title, status, updated_at, updated_by; rows = list<BlogArticle>; row actions Edit / Delete (POST + CSRF FormView
  behind a Confirm); filters = BlogArticleFilterType; Pagination; EmptyState admin.articles.empty), and the 1.x
  variables page_title, items, pagination, filters, filter_form, delete_forms.
  Data block filled: nowo_ui_list_row (cells).
#}
{% extends '@NowoUiKit/page/list.html.twig' %}
{% trans_default_domain 'NowoBlogKitBundle' %}

{% block nowo_ui_styles %}
    {{ parent() }}
    {{ include('@NowoBlogKitBundle/_stylesheets.html.twig') }}
{% endblock %}

{% block nowo_ui_list_row %}
    {% set _b = page.bundle %}
    {% set _cell = nowo_ui_class('table_cell', _b) %}
    <td class="{{ _cell }} nowo-ui-cell--end" data-label="{{ 'admin.column.position'|trans }}">{{ row.position }}</td>
    <td class="{{ _cell }}" data-label="{{ 'admin.column.slug'|trans }}"><code class="{{ nowo_ui_class('code', _b) }}">/blog/{{ row.slug }}</code></td>
    <td class="{{ _cell }}" data-label="{{ 'admin.column.title'|trans }}" data-required="1">{{ row.title(nowo_blog_kit_default_locale) }}</td>
    <td class="{{ _cell }}" data-label="{{ 'admin.column.status'|trans }}">
        <span class="{{ nowo_ui_class(row.published ? 'badge_success' : 'badge_neutral', _b) }}">{{ (row.published ? 'admin.status.published' : 'admin.status.draft')|trans }}</span>
    </td>
    {{ include('@NowoBlogKitBundle/admin/_audit_cells.html.twig', {item: row, bundle: _b}) }}
{% endblock %}
