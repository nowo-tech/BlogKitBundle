{% trans_default_domain 'NowoBlogKitBundle' %}
{% import '@NowoUiKitBundle/macros/ui.html.twig' as ui %}
{% set _css_fw = nowo_blog_kit_css_framework|default('bootstrap5') %}
{% extends '@NowoBlogKitBundle/admin/base.html.twig' %}
{% block title %}{{ page_title|trans }}{% endblock %}
{% block admin %}
<div class="{{ ui.page_header(_css_fw) }}">
  <div><h1>{{ page_title|trans }}</h1></div>
  <div class="{{ ui.toolbar(_css_fw) }}">
    <a href="{{ path('admin_blog_new') }}" class="{{ ui.btn('primary', null, _css_fw) }}">{{ 'admin.articles.new'|trans }}</a>
    {% if nowo_blog_kit_can_configure %}
      <a href="{{ path('admin_blog_settings') }}" class="{{ ui.btn('secondary', null, _css_fw) }}">{{ 'admin.settings.title'|trans }}</a>
    {% endif %}
    <a href="{{ path('admin_blog_tags_index') }}" class="{{ ui.btn('secondary', null, _css_fw) }}">{{ 'admin.tags.title'|trans }}</a>
    {% if nowo_blog_kit_can_moderate %}
      <a href="{{ path('admin_blog_comments_index') }}" class="{{ ui.btn('secondary', null, _css_fw) }}">{{ 'admin.comments.title'|trans }}</a>
    {% endif %}
  </div>
</div>
{{ include('@NowoBlogKitBundle/admin/_list_filters.html.twig', {
  route: 'admin_blog_index',
  filter_form: filter_form,
  filters: filters|default({}),
}) }}

<div class="{{ ui.card(_css_fw) }}">
  <div class="{{ ui.table_wrap(_css_fw) }}">
    <table class="{{ ui.table(_css_fw) }}">
      <thead>
        <tr>
          <th scope="col">{{ 'admin.column.position'|trans }}</th>
          <th scope="col">{{ 'admin.column.slug'|trans }}</th>
          <th scope="col">{{ 'admin.column.title'|trans }}</th>
          <th scope="col">{{ 'admin.column.status'|trans }}</th>
          {{ include('@NowoBlogKitBundle/admin/_audit_table_heads.html.twig') }}
          <th scope="col"><span class="visually-hidden">{{ 'admin.column.actions'|trans }}</span></th>
        </tr>
      </thead>
      <tbody>
        {% for item in items %}
          <tr>
            <td>{{ item.position }}</td>
            <td><code>/blog/{{ item.slug }}</code></td>
            <td>{{ item.title(nowo_blog_kit_default_locale) }}</td>
            <td>
              {% if item.published %}
                {{ 'admin.status.published'|trans }}
              {% else %}
                {{ 'admin.status.draft'|trans }}
              {% endif %}
            </td>
            {{ include('@NowoBlogKitBundle/admin/_audit_table_cells.html.twig', {item: item}) }}
            <td>
              {% if nowo_blog_kit_can_manage_article(item) %}
              {{ include('@NowoBlogKitBundle/admin/_row_actions.html.twig', {actions: [
                {kind: 'edit', href: path('admin_blog_edit', {id: item.id}), label: 'admin.action.edit'|trans},
                {
                  kind: 'delete',
                  tag: 'button',
                  confirm_id: 'blog-delete-article-' ~ item.id,
                  label: 'admin.action.delete'|trans,
                },
              ]}) }}
              {% if delete_forms[item.id] is defined %}
                {{ include('@NowoBlogKitBundle/admin/_delete_confirm.html.twig', {
                  id: 'blog-delete-article-' ~ item.id,
                  form: delete_forms[item.id],
                  title: 'admin.confirm.delete_title'|trans,
                  body: 'admin.confirm.delete_article'|trans,
                }) }}
              {% endif %}
              {% endif %}
            </td>
          </tr>
        {% else %}
          <tr><td colspan="7">{{ 'admin.articles.empty'|trans }}</td></tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>
{{ include('@NowoBlogKitBundle/admin/_pagination.html.twig', {pagination: pagination|default(null), route: 'admin_blog_index', filters: filters|default({})}) }}
{% endblock %}
