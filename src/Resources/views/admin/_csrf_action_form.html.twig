{% trans_default_domain 'NowoBlogKitBundle' %}
{{ form_start(form, {attr: attr|default({})}) }}
  {% for child in form %}
    {% if not child.rendered %}
      {{ form_row(child) }}
    {% endif %}
  {% endfor %}
  <button type="submit" class="{{ button_class }}"{% if confirm_message|default(false) %} data-confirm="{{ confirm_message }}"{% endif %}>{{ button_label }}</button>
{{ form_end(form) }}
