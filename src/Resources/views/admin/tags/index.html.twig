{#
  Tags (REQ-UI-003): UiKit list scaffold. Variables: page (View\ListPage from BlogTagController::index(): header
  admin.tags.title / admin.tags.lead with the action New tag and the blog area nav as tabs; columns slug, name,
  articles; rows = list<BlogTag>; row actions Edit / Delete (POST + CSRF FormView behind a Confirm); filters =
  BlogTagFilterType; EmptyState admin.tags.empty with New tag), article_counts (tag id => published articles), and
  the 1.x variables page_title, items, filters, filter_form, delete_forms.
  Data block filled: nowo_ui_list_row (cells).
#}
{% extends '@NowoUiKit/page/list.html.twig' %}
{% trans_default_domain 'NowoBlogKitBundle' %}

{% block nowo_ui_styles %}
    {{ parent() }}
    {{ include('@NowoBlogKitBundle/_stylesheets.html.twig') }}
{% endblock %}

{% block nowo_ui_list_row %}
    {% set _b = page.bundle %}
    {% set _cell = nowo_ui_class('table_cell', _b) %}
    <td class="{{ _cell }}" data-label="{{ 'admin.column.slug'|trans }}"><code class="{{ nowo_ui_class('code', _b) }}">{{ row.slug }}</code></td>
    <td class="{{ _cell }}" data-label="{{ 'admin.column.name'|trans }}" data-required="1">{{ row.name(nowo_blog_kit_default_locale) }}</td>
    <td class="{{ _cell }} nowo-ui-cell--end" data-label="{{ 'admin.column.articles'|trans }}">{{ article_counts[row.id]|default(0) }}</td>
{% endblock %}
