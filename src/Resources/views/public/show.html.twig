{#
  Public article (REQ-UI-003 unique page, listed in docs/TEMPLATES.md): the host's public front page, no admin
  chrome — extends web_ui.public_layout_template (nowo_blog_kit_page_layout), else the UiKit guest layout
  (nowo_ui_kit.layouts.guest). Variables: header (View\PageHeader: article title / excerpt), page_title,
  page_description, article, article_id, comments, comment_form, reply_forms, can_moderate_comments, filters,
  search_form, sidebar_related, sidebar_tags, sidebar_resources, aside_left, aside_right, show_share, show_comments,
  show_source_link, hero_image_mode, breadcrumbs (host breadcrumb data).
  Blocks filled: nowo_ui_document_title, nowo_ui_head (meta description), nowo_ui_styles / nowo_ui_scripts (bundle
  assets after parent()), nowo_ui_page_header (UiKit page-header contract: title, excerpt), nowo_ui_content (meta,
  tags, hero image, body, share, source link, comments).
#}
{% extends nowo_blog_kit_page_layout ?? nowo_ui_layout.guest %}
{% trans_default_domain 'NowoBlogKitBundle' %}
{% set nowo_ui_bundle = 'NowoBlogKitBundle' %}

{% block nowo_ui_document_title %}{{ page_title }}{% endblock %}

{% block nowo_ui_head %}
    {{ parent() }}
    {{ include('@NowoBlogKitBundle/public/_meta.html.twig') }}
{% endblock %}

{% block nowo_ui_styles %}
    {{ parent() }}
    {{ include('@NowoBlogKitBundle/_stylesheets.html.twig') }}
{% endblock %}

{% block nowo_ui_page_header %}{{ nowo_ui_page_header(header) }}{% endblock %}

{% block nowo_ui_content %}
{% set _b = nowo_ui_bundle %}
<article class="blog-section" data-testid="blog-kit-article">
  <div class="blog-container">
    {% set has_left = aside_left is not empty %}
    {% set has_right = aside_right is not empty %}
    <div class="blog-layout{{ has_left and has_right ? ' blog-layout--both' : (has_left ? ' blog-layout--left' : '') }}">
      {% if has_left %}
        <div class="blog-layout__aside blog-layout__aside--left">
          {{ include('@NowoBlogKitBundle/public/_aside_show.html.twig', {
            side: 'left',
            widgets: aside_left,
            filters: filters,
            search_form: search_form,
            sidebar_related: sidebar_related,
            sidebar_tags: sidebar_tags,
            sidebar_resources: sidebar_resources,
            article: article,
          }) }}
        </div>
      {% endif %}

      <div class="blog-layout__main blog-article">
        <header class="blog-article__header">
          {% if article.published_at %}
            <p class="blog-item__meta {{ nowo_ui_class('muted', _b) }}">
              <time datetime="{{ article.published_at }}">{{ article.published_at }}</time>
            </p>
          {% endif %}
          {% if article.tags is not empty %}
            <ul class="blog-article__tags">
              {% for tag in article.tags %}
                <li>
                  <a href="{{ path('blog_index', {tag: tag.slug}) }}" class="blog-tag">{{ tag.name }}</a>
                </li>
              {% endfor %}
            </ul>
          {% endif %}
        </header>

        {% if article.image %}
          <figure class="blog-article__figure">
            <img
              src="{{ article.image }}"
              alt=""
              class="blog-article__image blog-article__image--{{ hero_image_mode|default('contain') }}"
            >
          </figure>
        {% endif %}

        <div class="blog-article__body">
          {{ article.body|raw }}
        </div>

        {% if show_share|default(true) %}
          <section class="blog-article__share" aria-labelledby="blog-share-heading">
            <h2 id="blog-share-heading" class="blog-article__share-title">{{ 'page.blog.share'|trans }}</h2>
            <ul class="blog-share">
              <li><a href="https://www.linkedin.com/sharing/share-offsite/?url={{ app.request.uri|url_encode }}" rel="noopener noreferrer" target="_blank">LinkedIn</a></li>
              <li><a href="https://twitter.com/intent/tweet?url={{ app.request.uri|url_encode }}&text={{ article.title|url_encode }}" rel="noopener noreferrer" target="_blank">X</a></li>
            </ul>
          </section>
        {% endif %}

        {% if show_source_link|default(true) and article.linkedin_url %}
          <p class="blog-article__source">
            <a href="{{ article.linkedin_url }}" rel="noopener noreferrer" target="_blank">{{ 'page.blog.original_linkedin'|trans }}</a>
          </p>
        {% endif %}

        {% if show_comments|default(true) %}
          {{ include('@NowoBlogKitBundle/public/_comments.html.twig') }}
        {% endif %}
      </div>

      {% if has_right %}
        <div class="blog-layout__aside blog-layout__aside--right">
          {{ include('@NowoBlogKitBundle/public/_aside_show.html.twig', {
            side: 'right',
            widgets: aside_right,
            filters: filters,
            search_form: search_form,
            sidebar_related: sidebar_related,
            sidebar_tags: sidebar_tags,
            sidebar_resources: sidebar_resources,
            article: article,
          }) }}
        </div>
      {% endif %}
    </div>
  </div>
</article>
{% endblock %}

{% block nowo_ui_scripts %}
    {{ parent() }}
    {{ include('@NowoBlogKitBundle/_scripts.html.twig') }}
{% endblock %}
