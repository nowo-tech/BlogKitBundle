{% trans_default_domain 'NowoBlogKitBundle' %}
{% import '@NowoUiKitBundle/macros/ui.html.twig' as ui %}
{% set _css_fw = nowo_blog_kit_css_framework|default('bootstrap5') %}
{% set opts = card_options|default({show_image: true, show_excerpt: true, show_tags: true}) %}
{% for article in articles %}
  <article class="blog-item blog-masonry__item">
    {% if opts.show_image and article.image %}
      <a href="{{ path('blog_show', {slug: article.slug}) }}" class="blog-item__image-link">
        <img src="{{ article.image }}" alt="" class="blog-item__image" loading="lazy">
      </a>
    {% endif %}
    <div class="blog-item__content">
      {% if article.published_at %}
        <p class="blog-item__meta">
          <time datetime="{{ article.published_at }}">{{ article.published_at }}</time>
        </p>
      {% endif %}
      <h2 class="blog-item__title">
        <a href="{{ path('blog_show', {slug: article.slug}) }}">{{ article.title }}</a>
      </h2>
      {% if opts.show_excerpt and article.excerpt %}
        <p class="blog-item__excerpt">{{ article.excerpt }}</p>
      {% endif %}
      {% if opts.show_tags and article.tags is not empty %}
        <ul class="blog-item__tags">
          {% for tag in article.tags %}
            <li>
              <a href="{{ path('blog_index', filters.q ? {q: filters.q, tag: tag.slug} : {tag: tag.slug}) }}" class="blog-tag blog-tag--sm">{{ tag.name }}</a>
            </li>
          {% endfor %}
        </ul>
      {% endif %}
      <a href="{{ path('blog_show', {slug: article.slug}) }}" class="{{ ui.btn('secondary', 'sm', _css_fw) }}">{{ 'page.blog.read_more'|trans }}</a>
    </div>
  </article>
{% endfor %}
