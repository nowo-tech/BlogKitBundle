{% trans_default_domain 'NowoBlogKitBundle' %}
{% set _b = 'NowoBlogKitBundle' %}
{% set compact = compact|default(false) %}
{{ form_start(search_form, {attr: {class: 'blog-search' ~ (compact ? ' blog-search--aside' : ''), role: 'search'}}) }}
    {% if search_form.q is defined %}
        <label class="visually-hidden" for="{{ search_form.q.vars.id }}">{{ 'page.blog.search_label'|trans }}</label>
        {{ form_widget(search_form.q) }}
    {% endif %}
    {% for child in search_form %}
        {% if not child.rendered %}
            {{ form_widget(child) }}
        {% endif %}
    {% endfor %}
    <div class="blog-search__actions">
        <button type="submit" class="{{ nowo_ui_class('btn_primary', _b) }} {{ nowo_ui_class('btn_sm', _b) }}">{{ 'page.blog.search_submit'|trans }}</button>
        {% if filters.q or filters.tag %}
            <a href="{{ path('blog_index') }}" class="{{ nowo_ui_class('btn_secondary', _b) }} {{ nowo_ui_class('btn_sm', _b) }}">{{ 'page.blog.search_clear'|trans }}</a>
        {% endif %}
    </div>
{{ form_end(search_form) }}
