{% extends nowo_blog_kit_public_layout %}
{% trans_default_domain 'NowoBlogKitBundle' %}

{# REQ-UI-001: stack public assets via parent() when the host sets public_layout_template. #}
{% block stylesheets %}
    {{ parent() }}
    {% block nowo_ui_styles %}
        <link rel="stylesheet" href="{{ asset('css/nowo-ui.css', 'nowo_ui_kit') }}">
        <link rel="stylesheet" href="{{ asset('blog.css', 'nowo_blog_kit') }}">
    {% endblock %}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {% block nowo_ui_scripts %}
        <script src="{{ asset('blog-kit.js', 'nowo_blog_kit') }}" defer></script>
    {% endblock %}
{% endblock %}
